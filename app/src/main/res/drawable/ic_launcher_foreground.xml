                android:startY="46"
                android:endX="58"
                android:endY="62"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#A5F3FC" android:offset="0.6" />
                <item android:color="#67E8F9" android:offset="1.0" />

    <!-- Dynamic AI Sparkle / Star at Core Center -->
    <path
        android:pathData="M 54,49 L 55.5,52.5 L 59,54 L 55.5,55.5 L 54,59 L 52.5,55.5 L 49,54 L 52.5,52.5 Z"

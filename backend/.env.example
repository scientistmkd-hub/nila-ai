# Gemini API Key (Required for AI chat)
# DO NOT commit the actual key to version control or source code
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
PORT=8080
NODE_ENV=production

# Gemini Model Selection (e.g. gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional Client Authentication Token (leave blank for development)
# NILA_BACKEND_AUTH_TOKEN=your_secure_client_token_here

# CORS allowed origins (comma separated or * for open access)
ALLOWED_ORIGINS=*

# Rate limiting (requests per minute per client)
RATE_LIMIT_MAX_PER_MINUTE=30

# Request timeout in milliseconds
REQUEST_TIMEOUT_MS=30000
